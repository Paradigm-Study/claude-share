// oxfmt (npm run format), on server/ and scripts/ for now: test/ and plugin/
// join once the sessions moving them are done. The house style, wrapped at
// 160 columns: most lines here are well under it, so wrapping touches only
// the long ones.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 160,
  "arrowParens": "avoid",
  "trailingComma": "all"
}
