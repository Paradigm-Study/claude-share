// oxlint (npm run lint), on server/, scripts/, cloud/, plugin/relay/ and test/ (with
// vitest.config.ts): its default correctness rules, and, with --type-aware
// (oxlint-tsgolint, the TypeScript the tsconfigs name), the rules about
// promises a Durable Object, or a helper's socket, can't afford to drop. Not plugin/hooks: their types are
// the engine's (plugin/.claude/types, copied in from a Claude Code session and
// git-ignored), so on CI every engine type would read as any.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    // Destructuring to leave a field out names what it leaves out.
    // A parameter named with a leading _ is there for its type: a placeholder
    // function a later assignment replaces.
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_" }],
    // `return void (await x)` is this code's way to end a function early.
    "typescript/no-meaningless-void-operator": "off",
    // Names, titles and file names have their control characters taken out on purpose.
    "no-control-regex": "off",
    // Its spreads copy a Set or Map before a loop that changes it, or turn a
    // Uint8Array into an array so map() can return strings.
    "unicorn/no-useless-spread": "off",
    // A request's values are coerced to strings on purpose, then checked.
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off"
  },
  "overrides": [
    // Search grams are made of code points, on purpose.
    { "files": ["server/traces/grams.ts"], "rules": { "typescript/no-misused-spread": "off" } },
    // A test's fixture server takes an async handler, its promise ignored by
    // node:net and node:http: one that fails is an unhandled rejection, which
    // fails the run. The rule stays whole for the server and the helpers.
    { "files": ["test/**"], "rules": { "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }] } }
  ]
}
