// The plugin's hooks and UI tests, checked against the engine's API
// (.claude/types, copied in by /plugin-types; npm run typecheck:plugin).
// noUnusedParameters stays off: a hook's handler takes ($, e, next) by
// position, and many use only the later ones.
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [".claude/types", "types", "hooks", "tests"]
}
